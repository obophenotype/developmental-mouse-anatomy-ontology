            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002489"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_27"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002493"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_28"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The urethral gland of pelvic urethra of male (TS:27-TS:28). Numerous epithelial urethral glands develop from the epithelium of the urethra. Develop from male urethral gland bud (TS:24-26) and become male urethral gland (TS:27-TS:28) which is subdivided into urethral gland of male pelvic urethra (part of the pelvic urethra) and urethral gland of penile urethra (part of the penile urethra).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:id>EMAPA:36423</oboInOwl:id>
        <rdfs:label>urethral gland of pelvic urethra of male</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMAPA_36423"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The urethral gland of pelvic urethra of male (TS:27-TS:28). Numerous epithelial urethral glands develop from the epithelium of the urethra. Develop from male urethral gland bud (TS:24-26) and become male urethral gland (TS:27-TS:28) which is subdivided into urethral gland of male pelvic urethra (part of the pelvic urethra) and urethral gland of penile urethra (part of the penile urethra).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


