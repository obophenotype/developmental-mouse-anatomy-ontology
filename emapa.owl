        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The os clitoridis (TS:28-28) is a tiny bone, variable in size (between 581-1840 um long, dependant on strain), located within the clitoris.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


