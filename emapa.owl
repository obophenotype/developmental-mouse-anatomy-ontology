                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002493"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_28"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The os clitoridis (TS:28-28) is a tiny bone, variable in size (between 581-1840 um long, dependant on strain), located within the clitoris.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:id>EMAPA:30823</oboInOwl:id>
        <rdfs:label>os clitoridis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
