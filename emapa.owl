    <!-- http://purl.obolibrary.org/obo/EMAPA_32293 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_32293">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMAPA_31552"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
