    <!-- http://purl.obolibrary.org/obo/EMAPA_36116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_36116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMAPA_36630"/>
