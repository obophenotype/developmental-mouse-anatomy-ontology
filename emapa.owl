    <!-- http://purl.obolibrary.org/obo/EMAPA_27665 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_27665">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMAPA_17381"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002489"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_19"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002493"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_26"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The paramesonephric duct (pnd) (syn: Mullerian duct) (TS:19). Paired epithelial ducts which develop laterally adjacent to the nephric ducts in the anterior mesonephros and extend caudally down the rostro-caudal length of the nephric ducts. Later, at TS:21, they will terminate at the urogenital sinus/pelvic urethra. Part of the reproductive system. The ducts are marked by Cdh1 and Pax2. As the ontology becomes gender-specific, the paramesonephric duct becomes the paramesonephric duct of male/female (from TS:20).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Mullerian duct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>EMAPA:27665</oboInOwl:id>
        <rdfs:label>paramesonephric duct</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMAPA_27665"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The paramesonephric duct (pnd) (syn: Mullerian duct) (TS:19). Paired epithelial ducts which develop laterally adjacent to the nephric ducts in the anterior mesonephros and extend caudally down the rostro-caudal length of the nephric ducts. Later, at TS:21, they will terminate at the urogenital sinus/pelvic urethra. Part of the reproductive system. The ducts are marked by Cdh1 and Pax2. As the ontology becomes gender-specific, the paramesonephric duct becomes the paramesonephric duct of male/female (from TS:20).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


