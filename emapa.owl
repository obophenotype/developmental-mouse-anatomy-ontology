    <!-- http://purl.obolibrary.org/obo/EMAPA_29645 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_29645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMAPA_35327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMAPA_18692"/>
            </owl:Restriction>
        </rdfs:subClassOf>
