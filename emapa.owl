    <!-- http://purl.obolibrary.org/obo/EMAPA_29850 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_29850">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMAPA_19294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
