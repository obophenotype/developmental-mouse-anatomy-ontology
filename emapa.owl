        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:id>EMAPA:31528</oboInOwl:id>
        <rdfs:label>nerve of urogenital sinus</rdfs:label>
