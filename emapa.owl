                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_27"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The female urethral gland (ur gland) (syn: Skene&apos;s gland) (TS:27-TS:28). Epithelial urethral glands develop from the epithelium of the urethra. Develop from female urethral gland bud (TS:24-TS:26). Part of the urethra of female, subdivided into urethral gland of pelvic urethra of female (part of the pelvic urethra) and urethral gland of clitoral urethra (part of the clitoral urethra).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Skene&apos;s gland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>EMAPA:29653</oboInOwl:id>
        <rdfs:label>female urethral gland</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMAPA_29653"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The female urethral gland (ur gland) (syn: Skene&apos;s gland) (TS:27-TS:28). Epithelial urethral glands develop from the epithelium of the urethra. Develop from female urethral gland bud (TS:24-TS:26). Part of the urethra of female, subdivided into urethral gland of pelvic urethra of female (part of the pelvic urethra) and urethral gland of clitoral urethra (part of the clitoral urethra).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


