            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cloaca associated mesenchyme (clam) (TS:17-TS:20) is the mesenchyme surrounding the cloacal epithelium of the cloaca, an epithelial lined cavity derived from endoderm, seen early in embryonic development located at the posterior end of the embryo.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>EMAPA:27642</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:id>EMAPA:27581</oboInOwl:id>
        <rdfs:label>cloaca associated mesenchyme</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMAPA_27581"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The cloaca associated mesenchyme (clam) (TS:17-TS:20) is the mesenchyme surrounding the cloacal epithelium of the cloaca, an epithelial lined cavity derived from endoderm, seen early in embryonic development located at the posterior end of the embryo.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


