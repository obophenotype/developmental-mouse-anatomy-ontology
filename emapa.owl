                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002489"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_27"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The male urethral gland (ur gland) (TS:27-TS:28). Numerous epithelial urethral glands develop from the epithelium of the urethra. Develop from male urethral gland bud (TS:24-26). Part of the urethra of male, subdivided into urethral gland of male pelvic urethra (part of the pelvic urethra) and urethral gland of penile urethra (part of the penile urethra).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:id>EMAPA:29645</oboInOwl:id>
        <rdfs:label>male urethral gland</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMAPA_29645"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The male urethral gland (ur gland) (TS:27-TS:28). Numerous epithelial urethral glands develop from the epithelium of the urethra. Develop from male urethral gland bud (TS:24-26). Part of the urethra of male, subdivided into urethral gland of male pelvic urethra (part of the pelvic urethra) and urethral gland of penile urethra (part of the penile urethra).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMAPA_29653 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_29653">
