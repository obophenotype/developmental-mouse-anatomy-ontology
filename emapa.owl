                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_28"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The corpus cavernosum of penile body (syn: corpora cavernosa, crus, crura) (TS:28). Located within the penile body, paired erectile tissues that extend laterally from the base of the penis towards the pubic bone, and are anchored to the pubic bone on each ischial tuberosity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>corpora cavernosa of penile body</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>crura</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>crus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>EMAPA:29850</oboInOwl:id>
        <rdfs:label>corpus cavernosum of penile body</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMAPA_29850"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The corpus cavernosum of penile body (syn: corpora cavernosa, crus, crura) (TS:28). Located within the penile body, paired erectile tissues that extend laterally from the base of the penis towards the pubic bone, and are anchored to the pubic bone on each ischial tuberosity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


