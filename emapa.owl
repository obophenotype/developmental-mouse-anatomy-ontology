                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002493"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TS_28"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The verumontanum (ver) (syn: seminal colliculus) (TS:24-TS:28) is the raised, dorsal portion of the male urethra where the prostate glands and orifices of the ejaculatory ducts enter the urethra. Part of the pelvic urethra of male (TS:24-TS:27), and in the adult is part of the prostatic urethra (TS:28). Also part of the male urethra. Derived from the urogenital sinus ridge of male (TS:23).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>anatomical_structure</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>seminal colliculus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>urethral crest</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>EMAPA:36137</oboInOwl:id>
        <rdfs:label>verumontanum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMAPA_36137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The verumontanum (ver) (syn: seminal colliculus) (TS:24-TS:28) is the raised, dorsal portion of the male urethra where the prostate glands and orifices of the ejaculatory ducts enter the urethra. Part of the pelvic urethra of male (TS:24-TS:27), and in the adult is part of the prostatic urethra (TS:28). Also part of the male urethra. Derived from the urogenital sinus ridge of male (TS:23).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25968320</oboInOwl:hasDbXref>
    </owl:Axiom>
    


