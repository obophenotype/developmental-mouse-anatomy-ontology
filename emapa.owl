    <!-- http://purl.obolibrary.org/obo/EMAPA_36407 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_36407">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMAPA_29856"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
