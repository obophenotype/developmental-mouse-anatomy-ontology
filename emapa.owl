    <!-- http://purl.obolibrary.org/obo/EMAPA_31500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_31500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMAPA_16576"/>
