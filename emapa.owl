    <!-- http://purl.obolibrary.org/obo/EMAPA_30423 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMAPA_30423">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMAPA_30984"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
